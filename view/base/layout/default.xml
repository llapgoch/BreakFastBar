<?xml version="1.0"?>
<page>
    <head>
        <css src="Llapgoch_BreakFastBar::css/breakfastbar.css" />
        <!-- Include these in the head so they're always there for hyva -->
        <link src="Llapgoch_BreakFastBar::js/toolbar.init.js" />
        <link src="Llapgoch_BreakFastBar::js/toolbar.controller.js" />
        <link src="Llapgoch_BreakFastBar::js/toolbar.widget.js" />
        <link src="Llapgoch_BreakFastBar::js/toolbar.blockviewer.widget.js" />
        <link src="Llapgoch_BreakFastBar::js/toolbar.luma.js" />
        <link src="Llapgoch_BreakFastBar::js/toolbar.alpine.js" />
    </head>

    <body>
        <container name="llapgoch.breakfastbar" htmlTag="div" htmlClass="devbar js-breakfastbar-controller">
            <block class="Magento\Framework\View\Element\Template"
                name="llapgoch.breakfastbar.bg"
                template="Llapgoch_BreakFastBar::toolbar/background.phtml" />

            <block class="Magento\Framework\View\Element\Template" name='llapgoch.breakfastbar.logo'
                template='Llapgoch_BreakFastBar::logo.phtml' />

            <block class="Llapgoch\BreakFastBar\Block\Panel\BlockPanel"
                name="llapgoch-breakfastbar-block"
                template="Llapgoch_BreakFastBar::toolbar/panel.phtml">
                <block class="Magento\Framework\View\Element\Template"
                    name="llapgoch-breakfastbar-block-actions" as="actions"
                    template="Llapgoch_BreakFastBar::toolbar/block/actions.phtml" />
            </block>

            <block class="Llapgoch\BreakFastBar\Block\Panel\HandlePanel"
                name="llapgoch-breakfastbar-handle"
                template="Llapgoch_BreakFastBar::toolbar/panel.phtml">
                <block class="Llapgoch\BreakFastBar\Block\Panel\Handle\Content"
                    name="llapgoch-breakfastbar-handle-content" as="content"
                    template="Llapgoch_BreakFastBar::toolbar/handle/content.phtml" />
            </block>

            <block class="Llapgoch\BreakFastBar\Block\Panel\RequestPanel"
                name="llapgoch-breakfastbar-request"
                template="Llapgoch_BreakFastBar::toolbar/panel.phtml">
                <block class="Llapgoch\BreakFastBar\Block\Panel\Request\Content"
                    name="llapgoch-breakfastbar-request-content" as="content"
                    template="Llapgoch_BreakFastBar::toolbar/request/content.phtml" />
            </block>

            <block class="Llapgoch\BreakFastBar\Block\Panel\LumaPanel"
                name="llapgoch-breakfastbar-luma"
                template="Llapgoch_BreakFastBar::toolbar/panel.phtml">
                <block class="Magento\Framework\View\Element\Template"
                    name="llapgoch-breakfastbar-luma-content" as="content"
                    template="Llapgoch_BreakFastBar::toolbar/luma/content.phtml" />
                <block class="Magento\Framework\View\Element\Template"
                    name="llapgoch-breakfastbar-luma-actions" as="actions"
                    template="Llapgoch_BreakFastBar::toolbar/luma/actions.phtml" />
            </block>

            <block class="Llapgoch\BreakFastBar\Block\Panel\AlpinePanel"
                name="llapgoch-breakfastbar-alpine"
                template="Llapgoch_BreakFastBar::toolbar/panel.phtml">
                <block class="Magento\Framework\View\Element\Template"
                    name="llapgoch-breakfastbar-alpine-content" as="content"
                    template="Llapgoch_BreakFastBar::toolbar/alpine/content.phtml" />
                <block class="Magento\Framework\View\Element\Template"
                    name="llapgoch-breakfastbar-alpine-actions" as="actions"
                    template="Llapgoch_BreakFastBar::toolbar/alpine/actions.phtml" />
            </block>
        </container>
    </body>
</page>
